# NGLab Environment Variables
# Copy this file to .env and fill in your values

# =================================================================
# Logging & Tracking
# =================================================================

# Weights & Biases API Key for experiment tracking
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=nglab
WANDB_ENTITY=your_wandb_username

# MLflow Tracking Server
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=nglab_experiments

# =================================================================
# Hardware Configuration
# =================================================================

# CUDA GPU Selection (comma-separated device IDs, e.g., "0,1")
CUDA_VISIBLE_DEVICES=0

# PyTorch Performance Settings
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

# =================================================================
# Visualization & Debugging
# =================================================================

# Rerun.io Recording Path
RERUN_RECORDING_PATH=./rerun_recordings

# Enable detailed logging
DEBUG_MODE=false
LOG_LEVEL=INFO

# =================================================================
# Data & APIs
# =================================================================

# Polymarket API Configuration
POLYMARKET_API_URL=https://clob.polymarket.com
# POLYMARKET_API_KEY=your_api_key_if_needed

# Data Storage Paths
DATA_DIR=./data
MODEL_WEIGHTS_DIR=./model_weights
CHECKPOINT_DIR=./checkpoints

# =================================================================
# Cloud Storage (Optional)
# =================================================================

# AWS S3 Configuration
# AWS_ACCESS_KEY_ID=your_access_key
# AWS_SECRET_ACCESS_KEY=your_secret_key
# AWS_DEFAULT_REGION=us-east-1
# S3_BUCKET_NAME=nglab-models

# Google Cloud Storage
# GCS_BUCKET_NAME=nglab-models
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# =================================================================
# Training Configuration
# =================================================================

# Random Seed for Reproducibility
SEED=42

# Distributed Training
MASTER_ADDR=localhost
MASTER_PORT=29500
WORLD_SIZE=1
RANK=0

# =================================================================
# Database (PostgreSQL)
# =================================================================

# Database Connection
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nglab
DB_USER=postgres
DB_PASSWORD=your_db_password

# =================================================================
# Security
# =================================================================

# Secret key for session management
SECRET_KEY=your_secret_key_here

# API Authentication
# API_TOKEN=your_api_token
