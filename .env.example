# =============================================================================
# NGLab Environment Variables
# Copy this file to .env and fill in your values
# =============================================================================

# =============================================================================
# General Configuration
# =============================================================================
NGLAB_ENV=development                  # development, staging, production
NGLAB_VERSION=latest                   # Docker image tag
DEBUG_MODE=false
LOG_LEVEL=INFO                         # DEBUG, INFO, WARNING, ERROR

# =============================================================================
# Database Configuration (PostgreSQL)
# =============================================================================
DB_HOST=localhost
DB_PORT=5432
DB_NAME=nglab
DB_USER=postgres
DB_PASSWORD=your_db_password

# Aliases for Docker Compose compatibility
POSTGRES_HOST=${DB_HOST}
POSTGRES_PORT=${DB_PORT}
POSTGRES_DB=${DB_NAME}
POSTGRES_USER=${DB_USER}
POSTGRES_PASSWORD=${DB_PASSWORD}

# =============================================================================
# Cache Configuration (Redis)
# =============================================================================
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=                        # Optional: leave empty if no auth

# =============================================================================
# API Server Configuration
# =============================================================================
API_HOST=0.0.0.0
API_PORT=8000
API_WORKERS=4                          # Number of Gunicorn workers
API_REPLICAS=2                         # Docker Compose replicas

# =============================================================================
# Hardware Configuration
# =============================================================================
# CUDA GPU Selection (comma-separated device IDs, e.g., "0,1")
CUDA_VISIBLE_DEVICES=0
GPU_COUNT=1                            # Number of GPUs for Docker
TORCH_CUDA_ARCH_LIST=7.0;7.5;8.0;8.6;9.0  # CUDA architectures

# PyTorch Performance Settings
OMP_NUM_THREADS=4
MKL_NUM_THREADS=4

# =============================================================================
# Model Storage Configuration
# =============================================================================
NGLAB_MODEL_STORAGE=local              # local, s3, gcs

# Local Storage Paths
DATA_DIR=./data
MODEL_WEIGHTS_DIR=./model_weights
CHECKPOINT_DIR=./checkpoints

# AWS S3 Configuration (if NGLAB_MODEL_STORAGE=s3)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
S3_BUCKET_NAME=nglab-models

# Google Cloud Storage Configuration (if NGLAB_MODEL_STORAGE=gcs)
GCS_BUCKET_NAME=nglab-models
GOOGLE_APPLICATION_CREDENTIALS=/path/to/credentials.json

# =============================================================================
# Monitoring Configuration
# =============================================================================
# Prometheus
PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# Grafana
GRAFANA_USER=admin
GRAFANA_PASSWORD=your-grafana-password
GRAFANA_ROOT_URL=http://localhost:3000

# =============================================================================
# Tracing Configuration (OpenTelemetry / Jaeger)
# =============================================================================
OTEL_SERVICE_NAME=nglab-api
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317

# =============================================================================
# Experiment Tracking
# =============================================================================
# Weights & Biases
WANDB_API_KEY=your_wandb_api_key_here
WANDB_PROJECT=nglab
WANDB_ENTITY=your_wandb_username

# MLflow
MLFLOW_TRACKING_URI=http://localhost:5000
MLFLOW_EXPERIMENT_NAME=nglab_experiments

# Rerun.io Recording Path
RERUN_RECORDING_PATH=./rerun_recordings

# =============================================================================
# Training Configuration
# =============================================================================
SEED=42
NGLAB_DEVICE=cuda                      # cuda, cpu, mps
NGLAB_MAX_EPOCHS=100
NGLAB_BATCH_SIZE=64
NGLAB_NUM_WORKERS=4

# Mixed Precision Training
NGLAB_MIXED_PRECISION=true             # Enable FP16/BF16 training
NGLAB_PRECISION=16-mixed               # 16-mixed, bf16-mixed, 32

# Distributed Training
MASTER_ADDR=localhost
MASTER_PORT=29500
WORLD_SIZE=1
RANK=0

# =============================================================================
# External APIs
# =============================================================================
# Polymarket API Configuration
POLYMARKET_API_URL=https://clob.polymarket.com
# POLYMARKET_API_KEY=your_api_key_if_needed

# =============================================================================
# Security
# =============================================================================
# Secret key for session management
SECRET_KEY=your_secret_key_here

# JWT Configuration
JWT_SECRET_KEY=your-jwt-secret-key-here
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=24

# API Authentication
# API_TOKEN=your_api_token

# HashiCorp Vault (optional)
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=
VAULT_NAMESPACE=
