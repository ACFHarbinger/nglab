# =============================================================================
# NGLab Production Dockerfile
# Multi-stage build for optimized production image
# =============================================================================

ARG PYTHON_VERSION=3.11
ARG RUST_VERSION=1.83

# =============================================================================
# Stage 1: Rust Builder
# =============================================================================
FROM rust:${RUST_VERSION}-slim-bookworm AS rust-builder

WORKDIR /build

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config \
    libssl-dev \
    python3-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy Rust source
COPY rust/ ./rust/
WORKDIR /build/rust

# Build release with optimizations
# We remove --locked to allow Cargo to handle stale lockfiles in the build environment
ENV CARGO_INCREMENTAL=0
ENV RUSTFLAGS="-C target-cpu=native -C opt-level=3"
RUN cargo build --release

# =============================================================================
# Stage 2: Python Builder
# =============================================================================
FROM python:${PYTHON_VERSION}-slim-bookworm AS python-builder

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    && rm -rf /var/lib/apt/lists/*

# Install uv for fast dependency resolution
RUN pip install uv

# 1. Copy project metadata and lockfiles FIRST (for caching)
COPY pyproject.toml uv.lock README.md ./

# 2. Copy the Rust source (required by maturin to build bindings)
COPY rust/ ./rust/

# 3. Copy the Python package source 
# This is often required for maturin to verify the module name or package structure
COPY nglab/ ./nglab/

# 4. Install production dependencies globally
# Maturin will now find README.md and the source code it needs
RUN uv pip install --system --no-cache .

# =============================================================================
# Stage 3: Final Runtime
# =============================================================================
FROM python:${PYTHON_VERSION}-slim-bookworm AS runtime

# Re-declare ARG to make it available in this stage
ARG NGLAB_VERSION=0.1.0
ENV VERSION=${NGLAB_VERSION}

LABEL org.opencontainers.image.version=${NGLAB_VERSION}
LABEL org.opencontainers.image.description="Nothing Gambles Like A Bot (NGLAB) Production Image"

# Create non-privileged user
RUN groupadd --gid 1000 nglab && \
    useradd --uid 1000 --gid nglab --shell /bin/bash --create-home nglab

WORKDIR /app

# Install runtime dependencies
# [linux/amd64 python-builder 3/8] 
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    pkg-config \
    libssl-dev \
    && rm -rf /var/lib/apt/lists/*

# Copy Python packages from builder
COPY --from=python-builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=python-builder /usr/local/bin /usr/local/bin

# Copy application code
COPY --chown=nglab:nglab python/src ./src
COPY --chown=nglab:nglab python/conf ./conf

# Create necessary directories
RUN mkdir -p /app/logs /app/models /app/.cache /tmp/prometheus && \
    chown -R nglab:nglab /app /tmp/prometheus

# Environment configuration
ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV NGLAB_ENV=production

# Prometheus multiprocess mode
ENV PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Switch to non-root user
USER nglab

# Expose API port
EXPOSE 8000

# Use tini as init system for proper signal handling
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-m", "api.main"]