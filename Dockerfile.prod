# =============================================================================
# NGLab Production Dockerfile
# Optimized for GitHub Actions / Low Disk Space Environments
# =============================================================================

ARG PYTHON_VERSION=3.11
ARG RUST_VERSION=1.83

# =============================================================================
# Stage 1: Builder
# =============================================================================
FROM python:${PYTHON_VERSION}-slim-bookworm AS builder

WORKDIR /app

# 1. Install build tools, Rust, and GUI headers (required for workspace compilation)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    pkg-config \
    libssl-dev \
    libglib2.0-dev \
    libgtk-3-dev \
    libwebkit2gtk-4.1-dev \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.cargo/bin:${PATH}"
ENV CARGO_INCREMENTAL=0
ENV RUSTFLAGS="-C target-cpu=native -C opt-level=3"

# 2. Build the application
RUN pip install --no-cache-dir uv
COPY pyproject.toml uv.lock README.md ./
COPY rust/ ./rust/
COPY nglab/ ./nglab/

# 3. Aggressive Space Optimization
RUN uv pip install --system --no-cache \
    --index-url https://download.pytorch.org/whl/cpu \
    --extra-index-url https://pypi.org/simple \
    . \
    && find /usr/local/lib/python3.11/site-packages -name "nvidia*" -type d -exec rm -rf {} + \
    && rm -rf /root/.cargo /root/.rustup /tmp/*

# =============================================================================
# Stage 2: Final Runtime (Ultra-slim)
# =============================================================================
FROM python:${PYTHON_VERSION}-slim-bookworm AS runtime

RUN groupadd --gid 1000 nglab && \
    useradd --uid 1000 --gid nglab --shell /bin/bash --create-home nglab

WORKDIR /app

# Final image ONLY needs shared libraries, not dev headers
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    libglib2.0-0 \
    libgtk-3-0 \
    libwebkit2gtk-4.1-0 \
    libgomp1 \
    curl \
    tini \
    && rm -rf /var/lib/apt/lists/* && apt-get clean

COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

COPY --chown=nglab:nglab python/src ./src
COPY --chown=nglab:nglab python/conf ./conf

RUN mkdir -p /app/logs /app/models /app/.cache /tmp/prometheus && \
    chown -R nglab:nglab /app /tmp/prometheus

ENV PYTHONPATH=/app/src \
    PYTHONUNBUFFERED=1 \
    NGLAB_ENV=production \
    PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

USER nglab
EXPOSE 8000
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-m", "api.main"]