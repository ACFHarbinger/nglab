# =============================================================================
# NGLab Production Dockerfile
# Multi-stage build for optimized production image
# =============================================================================

ARG PYTHON_VERSION=3.11
ARG RUST_VERSION=1.83

# =============================================================================
# Stage 1: Build Stage (Combined Rust & Python Build)
# =============================================================================
FROM python:${PYTHON_VERSION}-slim-bookworm AS builder

WORKDIR /app

# 1. Install system build dependencies
# We install the Rust toolchain directly to ensure compatibility and speed
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    pkg-config \
    libssl-dev \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    && rm -rf /var/lib/apt/lists/*

# Add cargo to the path
ENV PATH="/root/.cargo/bin:${PATH}"
ENV CARGO_INCREMENTAL=0
ENV RUSTFLAGS="-C target-cpu=native -C opt-level=3"

# 2. Install uv for high-speed dependency resolution
RUN pip install uv

# 3. Copy metadata and source code for building
COPY pyproject.toml uv.lock README.md ./
COPY rust/ ./rust/
COPY nglab/ ./nglab/

# 4. Build and install the package
# OPTIMIZATION: We explicitly point to the CPU-only wheel index for PyTorch.
# This prevents the builder from downloading ~4GB of CUDA binaries, solving the "No Space" error.
RUN uv pip install --system --no-cache \
    --index-url https://download.pytorch.org/whl/cpu \
    --extra-index-url https://pypi.org/simple \
    .

# =============================================================================
# Stage 2: Final Runtime (Ultra-slim)
# =============================================================================
FROM python:${PYTHON_VERSION}-slim-bookworm AS runtime

ARG NGLAB_VERSION=0.1.0
ENV VERSION=${NGLAB_VERSION}

LABEL org.opencontainers.image.version=${NGLAB_VERSION}
LABEL org.opencontainers.image.description="Nothing Gambles Like A Bot (NGLAB) Production Image"

# Create non-privileged user for security
RUN groupadd --gid 1000 nglab && \
    useradd --uid 1000 --gid nglab --shell /bin/bash --create-home nglab

WORKDIR /app

# 5. Install ONLY essential runtime libraries (no build tools)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    libgomp1 \
    curl \
    tini \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 6. Copy the compiled Python site-packages from the builder stage
# This carries over our built Rust extension module (_nglab.so)
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# 7. Copy application logic and configurations
COPY --chown=nglab:nglab python/src ./src
COPY --chown=nglab:nglab python/conf ./conf

# Setup directory permissions for Prometheus and logs
RUN mkdir -p /app/logs /app/models /app/.cache /tmp/prometheus && \
    chown -R nglab:nglab /app /tmp/prometheus

# Environment variables
ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV NGLAB_ENV=production
ENV PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# Health check to ensure the API is responding
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Execute as restricted user
USER nglab

# Default port
EXPOSE 8000

# Use tini to handle zombie processes (common in Python/ML workloads)
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-m", "api.main"]