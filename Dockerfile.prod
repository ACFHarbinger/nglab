# =============================================================================
# NGLab Production Dockerfile
# Multi-stage build for optimized production image
# =============================================================================

ARG PYTHON_VERSION=3.11
ARG RUST_VERSION=1.83

# =============================================================================
# Stage 1: Build Stage (Combined Rust & Python Build)
# =============================================================================
FROM python:${PYTHON_VERSION}-slim-bookworm AS builder

WORKDIR /app

# 1. Install system build dependencies
# We include Rust toolchain here to avoid Maturin downloading it again (saves time/space)
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    curl \
    pkg-config \
    libssl-dev \
    && curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y \
    && rm -rf /var/lib/apt/lists/*

ENV PATH="/root/.cargo/bin:${PATH}"
ENV CARGO_INCREMENTAL=0
ENV RUSTFLAGS="-C target-cpu=native -C opt-level=3"

# 2. Install uv for fast dependency resolution
RUN pip install uv

# 3. Copy project metadata and source code
COPY pyproject.toml uv.lock README.md ./
COPY rust/ ./rust/
COPY nglab/ ./nglab/

# 4. Install dependencies and build the package
# OPTIMIZATION: We use the CPU-only index for PyTorch to avoid 3GB+ of CUDA bloat.
# This is for the standard production image; use Dockerfile.gpu for GPU support.
RUN uv pip install --system --no-cache \
    --index-url https://download.pytorch.org/whl/cpu \
    --extra-index-url https://pypi.org/simple \
    .

# =============================================================================
# Stage 2: Final Runtime
# =============================================================================
FROM python:${PYTHON_VERSION}-slim-bookworm AS runtime

ARG NGLAB_VERSION=0.1.0
ENV VERSION=${NGLAB_VERSION}

LABEL org.opencontainers.image.version=${NGLAB_VERSION}
LABEL org.opencontainers.image.description="Nothing Gambles Like A Bot (NGLAB) Production Image"

# Create non-privileged user
RUN groupadd --gid 1000 nglab && \
    useradd --uid 1000 --gid nglab --shell /bin/bash --create-home nglab

WORKDIR /app

# 5. Install ONLY runtime dependencies (no build-essential, no -dev headers)
RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3 \
    libgomp1 \
    curl \
    tini \
    && rm -rf /var/lib/apt/lists/* \
    && apt-get clean

# 6. Copy Python packages from builder
# site-packages is now much smaller without the CUDA binaries
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# 7. Copy application code and configuration
COPY --chown=nglab:nglab python/src ./src
COPY --chown=nglab:nglab python/conf ./conf

# Create necessary directories
RUN mkdir -p /app/logs /app/models /app/.cache /tmp/prometheus && \
    chown -R nglab:nglab /app /tmp/prometheus

# Environment configuration
ENV PYTHONPATH=/app/src
ENV PYTHONUNBUFFERED=1
ENV PYTHONDONTWRITEBYTECODE=1
ENV NGLAB_ENV=production
ENV PROMETHEUS_MULTIPROC_DIR=/tmp/prometheus

# Health check
HEALTHCHECK --interval=30s --timeout=10s --start-period=40s --retries=3 \
    CMD curl -f http://localhost:8000/health || exit 1

# Switch to non-root user
USER nglab

# Expose API port
EXPOSE 8000

# Use tini as init system
ENTRYPOINT ["/usr/bin/tini", "--"]
CMD ["python", "-m", "api.main"]